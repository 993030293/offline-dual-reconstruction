diff --git a/utils/projective_validity.py b/utils/projective_validity.py
new file mode 100644
--- /dev/null
+++ b/utils/projective_validity.py
@@ -0,0 +1,18 @@
+"""Keep invalid camera-depth samples outside the differentiable projection domain."""
+
+import torch
+
+
+def normalize_camera_points(points, minimum_depth=0.0):
+    """Preserve supported rays and give unsupported rows a finite zero-gradient placeholder."""
+    valid = torch.isfinite(points).all(dim=-1) & (points[..., 2] > minimum_depth)
+    safe_points = torch.where(valid[..., None], points, torch.zeros_like(points))
+    denominator = torch.where(valid, points[..., 2], torch.ones_like(points[..., 2]))
+    return safe_points / denominator[..., None], valid
+
+
+def project_camera_points(points, camera, minimum_depth=0.0):
+    normalized, valid = normalize_camera_points(points, minimum_depth)
+    pixels = torch.stack((normalized[..., 0]*camera.Fx+camera.Cx,
+                          normalized[..., 1]*camera.Fy+camera.Cy), dim=-1)
+    return pixels, valid
